---
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';

const checklist = [
  '下单后到园里现摘，不卖陈果',
  '手工分选，碰伤、虫眼一律挑出',
  '单果网套 + 隔层纸箱，减少路上磕碰',
  '产地直发，不经中间环节',
];
---

<section class="harvest section" aria-labelledby="harvestTitle">
  <div class="wrap harvest__grid">
    <div class="harvest__copy">
      <p class="kicker reveal"><span>05</span>采摘与发货</p>
      <h2 class="h2 reveal" id="harvestTitle" style="--d:70ms">现摘现发，路上少待几天</h2>

      <div class="prose reveal" style="--d:140ms">
        <p>苹果不是摘下来堆在库房里慢慢卖的。订单来了，按量去园子里摘，摘完当天分选装箱。</p>
        <p>
          装箱前老马会一颗颗过手：碰伤的、有虫眼的、个头差太多的，都挑出去 —— 这些留着自家吃或者送人，不往外发。
        </p>
      </div>

      <ul class="checklist reveal" style="--d:210ms">
        {checklist.map((item) => <li>{item}</li>)}
      </ul>

      <p class="placeholder-note reveal" style="--d:280ms">
        规格、价格、起售量与快递方式，请直接联系老马确认 —— 每年果子的个头和产量不一样，按当年的实际情况报。
      </p>
    </div>

    <figure class="harvest__media reveal" style="--d:120ms">
      <Picture
        src={photo('apple-close.jpg')}
        alt="近处几颗套袋苹果泛着粉红，背景是虚化的果园"
        widths={[400, 560, 760]}
        sizes="(max-width: 940px) 92vw, 32vw"
        formats={['avif', 'webp']}
        quality={54}
        loading="lazy"
      />
      <figcaption>套着袋长起来的果子，果面是干净的。</figcaption>
    </figure>
  </div>
</section>

<style>
  .harvest__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    gap: clamp(34px, 6vw, 88px);
    align-items: center;
  }
  .harvest .h2 {
    margin-bottom: 26px;
  }

  .harvest__media {
    margin: 0;
  }
  .harvest__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-md);
    box-shadow: var(--sh-md);
    transition: transform 1.1s var(--ease-out);
  }
  .harvest__media:hover :global(img) {
    transform: scale(1.03);
  }
  .harvest__media figcaption {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--ink-4);
    padding-left: 16px;
    border-left: 2px solid var(--apple-soft);
    line-height: 1.8;
  }

  .checklist {
    list-style: none;
    margin: clamp(26px, 3.6vw, 40px) 0 0;
    padding: 0;
    display: grid;
    gap: 13px;
  }
  .checklist li {
    position: relative;
    padding-left: 30px;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 16px;
    height: 9px;
    border-left: 1.8px solid var(--leaf);
    border-bottom: 1.8px solid var(--leaf);
    transform: rotate(-45deg) translateY(-2px);
    transform-origin: left center;
  }

  .placeholder-note {
    margin-top: clamp(24px, 3vw, 34px);
    padding: 18px 22px;
    border-radius: var(--r-md);
    background: var(--paper-2);
    border: 1px dashed var(--line);
    font-size: 14.5px;
    color: var(--ink-3);
    line-height: 1.9;
  }

  @media (max-width: 940px) {
    .harvest__grid {
      grid-template-columns: 1fr;
      gap: clamp(30px, 6vw, 48px);
    }
    .harvest__media {
      order: -1;
      max-width: 460px;
    }
  }
</style>
